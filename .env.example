# IT8951 driver binary path (the C renderer, bundled in bin/)
IT8951_BINARY=/opt/eink-calendar/bin/it8951

# App server
APP_HOST=0.0.0.0
APP_PORT=8889

# SSL / HTTPS (self-signed cert auto-generated on first start)
SSL_ENABLED=1

# Google OAuth (path to client_secret.json downloaded from Google Cloud Console)
GOOGLE_CLIENT_SECRET=config/client_secret.json

# Settings file
SETTINGS_FILE=config/settings.json

# Render settings
RENDER_DPI=150